# --- Production (Netlify / Vercel) — required at build & runtime ---
# Your Render Flask API URL, no trailing slash
VITE_API_URL=https://your-creditwise-api.onrender.com

# --- Local development (optional) ---
# Leave unset to use Vite proxy: /api → http://localhost:5000
# Uncomment to call Render or another host while running npm run dev:
# VITE_API_URL=https://your-creditwise-api.onrender.com
